# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
# Comma-separated whitelist of Telegram user ids allowed to talk to the bot.
# (Find yours by messaging @userinfobot.)
ALLOWED_TELEGRAM_IDS=123456789

# --- GLM (Zhipu / Z.ai) ---
GLM_API_KEY=...
# International endpoint (default) or China endpoint:
#   https://api.z.ai/api/paas/v4
#   https://open.bigmodel.cn/api/paas/v4
GLM_BASE_URL=https://api.z.ai/api/paas/v4
# Text model (alternatives: glm-5.2, glm-5.3)
GLM_MODEL=glm-4.6
# Vision model for images
GLM_VISION_MODEL=glm-5.3-flash
# Speech-to-text model for voice notes
GLM_ASR_MODEL=glm-asr-2512

# --- Agent limits ---
MAX_TOOL_ITERS=8
TOOL_RESULT_LIMIT=8000
CONTEXT_TOKEN_BUDGET=32000

# --- Python sandbox ---
PY_TIMEOUT=60
PY_MEM_MB=1536

# --- Voice ---
MAX_VOICE_MINUTES=5

# --- Storage (defaults below suit local dev; in Docker use /app/workspace, /app/data) ---
# WORKSPACE_DIR=data/workspace
# DATA_DIR=data/bot

# --- Misc ---
# LOG_LEVEL=INFO
