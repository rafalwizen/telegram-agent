# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...
# Comma-separated whitelist of Telegram user ids allowed to talk to the bot.
# (Find yours by messaging @userinfobot.)
ALLOWED_TELEGRAM_IDS=123456789

# --- GLM (Zhipu / Z.ai) ---
# Recommended: GLM Coding Plan (Lite etc.) — everything runs within your plan's
# 5-hour windows, the same windows Claude Code uses.
#   GLM_API_KEY  = your Coding Plan key (the same one Claude Code uses)
#   GLM_BASE_URL = https://api.z.ai/api/coding/paas/v4
#   GLM_MODEL    = glm-5.2
# Pay-as-you-go alternative (requires balance): https://api.z.ai/api/paas/v4
# China platform: use https://open.bigmodel.cn/api/coding/paas/v4 and /api/anthropic
GLM_API_KEY=...
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL=glm-5.2
# Anthropic-compatible endpoint (image analysis, part of the Coding Plan):
GLM_ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic

# --- Agent limits ---
MAX_TOOL_ITERS=8
TOOL_RESULT_LIMIT=8000
CONTEXT_TOKEN_BUDGET=32000

# --- Python sandbox ---
PY_TIMEOUT=60
PY_MEM_MB=1536

# --- Storage (defaults below suit local dev; in Docker use /app/workspace, /app/data) ---
# WORKSPACE_DIR=data/workspace
# DATA_DIR=data/bot

# --- Misc ---
# LOG_LEVEL=INFO
